{
  "info": { "name": "OrderPilot — E-Commerce Order Management", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Import into Postman. Variables {{base}} defaults to http://localhost:4000/api. Run 'Login (customer)' first — it stores the token." },
  "variable": [{ "key": "base", "value": "http://localhost:4000/api" }],
  "item": [
    { "name": "Auth", "item": [
      { "name": "Login (customer)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"aarav@example.com\", \"password\": \"demo@123\" }" }, "url": "{{base}}/auth/login" },
        "event": { "listen": "test", "script": { "exec": ["pm.environment.set('token', pm.response.json().token);"] } } },
      { "name": "Login (admin)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"email\": \"admin@orderpilot.dev\", \"password\": \"admin@123\" }" }, "url": "{{base}}/auth/login" },
        "event": { "listen": "test", "script": { "exec": ["pm.environment.set('adminToken', pm.response.json().token);"] } } },
      { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"name\": \"New User\", \"email\": \"new@user.com\", \"password\": \"test@123\", \"phone\": \"9800000000\" }" }, "url": "{{base}}/auth/register" } }
    ]},
    { "name": "Catalog", "item": [
      { "name": "List products", "request": { "method": "GET", "url": { "raw": "{{base}}/products?q=&category=audio&sort=price_asc", "query": [{ "key": "q", "value": "" }, { "key": "category", "value": "audio" }, { "key": "sort", "value": "price_asc" }] } } },
      { "name": "Create product (admin)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{ \"sku\": \"NEW-DEMO1\", \"name\": \"Demo Widget\", \"price\": 1499, \"stock\": 25, \"category\": \"general\", \"emoji\": \"🧪\" }" }, "url": "{{base}}/products" } }
    ]},
    { "name": "Orders", "item": [
      { "name": "Quote cart", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"items\": [{ \"productId\": 1, \"qty\": 2 }], \"coupon\": \"FIRST10\", \"paymentMethod\": \"UPI\" }" }, "url": "{{base}}/orders/quote" } },
      { "name": "Place order", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productId\": 1, \"qty\": 2 }, { \"productId\": 6, \"qty\": 1 }],\n  \"coupon\": \"FIRST10\",\n  \"paymentMethod\": \"UPI\",\n  \"shipping\": { \"name\": \"Aarav Sharma\", \"phone\": \"9820011223\", \"address\": \"402 Sea Breeze Apartments, Bandra West\", \"city\": \"Mumbai\", \"state\": \"Maharashtra\", \"pincode\": \"400050\" },\n  \"notes\": \"Leave at the door\"\n}" }, "url": "{{base}}/orders" },
        "event": { "listen": "test", "script": { "exec": ["pm.environment.set('orderId', pm.response.json().order.id);", "pm.environment.set('orderNumber', pm.response.json().order.order_number);"] } } },
      { "name": "List my orders", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base}}/orders?page=1&limit=10" } },
      { "name": "Update address", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{ \"shipping\": { \"name\": \"Aarav Sharma\", \"phone\": \"9820011223\", \"address\": \"99 Marine Drive Cottage, Near Post Office\", \"city\": \"Mumbai\", \"state\": \"Maharashtra\", \"pincode\": \"400020\" } }" }, "url": "{{base}}/orders/{{orderId}}" } },
      { "name": "Advance status (admin)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{ \"status\": \"CONFIRMED\", \"note\": \"packed from rack B-2\" }" }, "url": "{{base}}/orders/{{orderId}}/status" } },
      { "name": "Cancel order", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{ \"reason\": \"Found a better price\" }" }, "url": "{{base}}/orders/{{orderId}}/cancel" } }
    ]},
    { "name": "Tracking", "item": [
      { "name": "Track (masked)", "request": { "method": "GET", "url": "{{base}}/orders/track/{{orderNumber}}" } },
      { "name": "Track (verified by pincode)", "request": { "method": "GET", "url": "{{base}}/orders/track/{{orderNumber}}?verify=400020" } }
    ]},
    { "name": "Admin stats", "item": [
      { "name": "Overview", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{base}}/stats/overview" } },
      { "name": "Revenue 14d", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{base}}/stats/revenue-daily?days=14" } },
      { "name": "Top products", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{base}}/stats/top-products" } },
      { "name": "Funnel", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{base}}/stats/funnel" } }
    ]}
  ]
}
